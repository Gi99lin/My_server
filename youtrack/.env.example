# Pin the YouTrack version explicitly (check https://hub.docker.com/r/jetbrains/youtrack/tags)
YT_VERSION=2026.2.17765

# Used by bootstrap/bootstrap_youtrack.py (NOT by the container itself)
# Create a permanent token in YouTrack: Profile → Account Security → Tokens
YT_URL=https://tracker.gigglin.tech
YT_TOKEN=perm:xxxxxxxx
