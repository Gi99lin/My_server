# Copy to .env and fill in.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGEME

# Host ports (127.0.0.1 only — reach via SSH tunnel, or via NPM/proxy_network
# for Grafana's grafana.gigglin.tech).
PROMETHEUS_PORT=9090
GRAFANA_PORT=3020

TZ=Europe/Moscow

# Image tags — bump deliberately, don't float on :latest for these two.
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:v0.49.1
NODE_EXPORTER_IMAGE=prom/node-exporter:latest
PROMETHEUS_IMAGE=prom/prometheus:latest
GRAFANA_IMAGE=grafana/grafana:11.3.0
