# Copy to .env and fill in the blanks (never commit the real .env — it's gitignored).
# Full reference: https://github.com/Gi99lin/mcp-telegram-cloud/blob/main/.env.example

# ── Required ──────────────────────────────────────────────────────────
# Telegram MTProto credentials for THIS deployment — obtain your own at
# https://my.telegram.org/apps (do not reuse the public mcp-telegram.com ones).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Public URL of this deployment. No trailing slash.
ISSUER=https://mcp-tg.gigglin.tech

# ── Server ────────────────────────────────────────────────────────────
PORT=3000
BRAND_NAME=Gigglin MCP Telegram

# ── Admin (bearer token for /api/*) ─────────────────────────────────────
ADMIN_TOKEN=

# ── Single-operator mode ─────────────────────────────────────────────────
# Always true for this deployment — gates /oauth/authorize, /login, /my/*
# behind the admin login below instead of the public multi-tenant flow.
SINGLE_OPERATOR_MODE=true
# Generate the hash with: bun scripts/hash-admin-password.ts (from a clone
# of https://github.com/Gi99lin/mcp-telegram-cloud)
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# ── Session encryption (at rest) ──────────────────────────────────────
# 32-byte key encrypting stored Telegram session strings. Generate with:
#   openssl rand -base64 32
# Keep a backup outside the server — losing it just forces a Telegram
# re-login, it doesn't lose data.
SESSION_ENCRYPTION_KEY=

# ── Observability ─────────────────────────────────────────────────────
MCP_TELEGRAM_TELEMETRY=local-only
LOG_SERVICE_NAME=mcp-telegram-cloud
LOG_USER_IDS=
LOG_HASH_SALT=

# ── Storage ───────────────────────────────────────────────────────────
DATABASE_PATH=./data/cloud.db
USAGE_LOG_RETENTION_DAYS=90

# ── Rate Limiting ─────────────────────────────────────────────────────
FREE_TIER_LIMIT=100
OAUTH_RATE_LIMIT=30
OAUTH_RATE_WINDOW_MS=60000
ADMIN_LOGIN_RATE_LIMIT=10
ADMIN_LOGIN_RATE_WINDOW_MS=900000
