# Non-secret pilot settings. Merge these with upstream defaults and server-only
# generated secrets; do not copy a populated environment into Git.
COMPOSE_PROJECT_NAME=dify-pilot
COMPOSE_PROFILES=weaviate,postgresql,collaboration
CONSOLE_API_URL=
CONSOLE_WEB_URL=
SERVICE_API_URL=
APP_API_URL=
APP_WEB_URL=
NGINX_HTTPS_ENABLED=false
NEXT_TELEMETRY_DISABLED=1
SERVER_WORKER_AMOUNT=1
CELERY_WORKER_AMOUNT=1
CELERY_WORKER_MIN_AMOUNT=1
CELERY_WORKER_MAX_AMOUNT=2
PLUGIN_PYTHON_ENV_INIT_TIMEOUT=300
# Permit only the internal LLM gateway, not all private networks.
SSRF_PROXY_ALLOW_PRIVATE_IPS=10.10.60.10/32

