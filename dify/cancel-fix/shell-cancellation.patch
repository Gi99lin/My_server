+async def _await_cancellation_safe[T](task: asyncio.Task[T]) -> T:
+    """Finish job creation or cleanup before propagating caller cancellation."""
+    try:
+        return await asyncio.shield(task)
+    except asyncio.CancelledError:
+        # A second cancel must not abandon an in-flight creation or cleanup.
+        while not task.done():
+            try:
+                await asyncio.shield(task)
+            except asyncio.CancelledError:
+                continue
+            except Exception:
+                break
+        if not task.cancelled():
+            # Retrieve a failed task's exception without replacing cancellation.
+            task.exception()
+        raise
+
