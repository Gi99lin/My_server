auto lo
iface lo inet loopback

iface nic0 inet manual

auto vmbr0
iface vmbr0 inet static
	address 192.168.1.12/24
	gateway 192.168.1.1
	bridge-ports nic0
	bridge-stp off
	bridge-fd 0
	post-up iptables -t nat -C PREROUTING -d 192.168.1.12/32 -p tcp --dport 443 -j REDIRECT --to-ports 8006 2>/dev/null || iptables -t nat -A PREROUTING -d 192.168.1.12/32 -p tcp --dport 443 -j REDIRECT --to-ports 8006

iface nic1 inet manual


auto vmbr1
iface vmbr1 inet manual
	bridge-ports none
	bridge-stp off
	bridge-fd 0
	bridge-vlan-aware yes
	bridge-vids 2-4094
#internal trunk for contours (router VM LAN side)

source /etc/network/interfaces.d/*
