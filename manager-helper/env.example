# Copy this to .env and fill in the blank values. Postgres/Redis already
# point at this compose file's own manager-helper-db/manager-helper-redis
# services — leave those two as-is.
POSTGRES_DSN=postgresql+asyncpg://mh:mh@manager-helper-db/mh
REDIS_URL=redis://manager-helper-redis:6379/0

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_BASE_URL=
TELEGRAM_PROXY=

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
TRANSCRIPTION_MODEL=

YOUTRACK_BASE_URL=
YOUTRACK_API_TOKEN=
YOUTRACK_DEFAULT_PROJECT_KEY=MHT
JIRA_POLL_INTERVAL_SECONDS=3600
JIRA_USER_SYNC_INTERVAL_SECONDS=86400

FERNET_KEY=
DIALOG_SESSION_TIMEOUT_HOURS=24

# Only used by this compose file's own postgres container, not read by the app.
POSTGRES_PASSWORD=mh
