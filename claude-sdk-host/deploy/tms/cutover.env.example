# Preparation only. Match the existing backend first; do not enable during TMS acceptance.
TMS_LLM_BACKEND=api
TMS_HOST_ALLOWED_USERS=REPLACE_WITH_OWNER_UUID_OR_EMAIL
TMS_HOST_SECRET_DIR=/etc/claude-sdk-host/secrets
TMS_HOST_TLS_DIR=/etc/claude-sdk-host/tms-provider-tls
TMS_HOST_DEPLOY_DIR=/ABSOLUTE/PATH/My_server/claude-sdk-host/deploy/tms
TMS_HOST_CADDYFILE=/ABSOLUTE/PATH/My_server/claude-sdk-host/deploy/tms/Caddyfile
# For docker-compose.testcase-host.yml, use Caddyfile.testcase and set the reviewed image:
TMS_HOST_BACKEND_IMAGE=REPLACE_WITH_REVIEWED_TMS_IMAGE
# The source must include codex/claude-host-integration and pass its current tests.
# Built-in runner remains enabled in TMS: COMPOSE_PROFILES=runner (preserve other profiles).
# No Claude subscription credential is placed here or in TMS.
