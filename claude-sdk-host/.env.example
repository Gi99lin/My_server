# ==============================================================================
# Claude SDK Host Environment Configuration (.env.example)
#
# IMPORTANT: Never commit actual API keys, secrets, or tokens to this repository.
# Operator secret directory must be stored outside Git (e.g. /etc/claude-sdk-host/secrets/).
# ==============================================================================

# Pinned Container Images
PLAYWRIGHT_IMAGE=mcr.microsoft.com/playwright/python:v1.64.1-noble
NETGUARD_IMAGE=alpine:3.20
GOST_IMAGE=ginuerzh/gost:2.11.5

# Host Secret Directory Path (Operator-provisioned outside repository, mounted read-only)
HOST_SECRETS_DIR=/etc/claude-sdk-host/secrets

# Static Hosts File (Generated via deploy/scripts/generate-peers.sh)
HOSTS_FILE=./deploy/hosts

# Internal Network Subnets (/28 CIDRs - verify with deploy/scripts/preflight-check.sh)
SDK_CLIENTS_SUBNET=172.31.240.0/28
SDK_CLIENTS_GATEWAY=172.31.240.1

SDK_TOOLS_SUBNET=172.31.240.16/28
SDK_TOOLS_GATEWAY=172.31.240.17

SDK_PROXY_SUBNET=172.31.240.32/28
SDK_PROXY_GATEWAY=172.31.240.33

SDK_UPSTREAM_SUBNET=172.31.240.48/28
SDK_UPSTREAM_GATEWAY=172.31.240.49

# Fixed Static IP Addresses
NETGUARD_CLIENTS_IP=172.31.240.2
NETGUARD_TOOLS_IP=172.31.240.18
NETGUARD_PROXY_IP=172.31.240.34

EGRESS_PROXY_IP=172.31.240.35
EGRESS_UPSTREAM_CLIENT_IP=172.31.240.50
EGRESS_UPSTREAM_IP=172.31.240.50
EGRESS_UPSTREAM_PORT=1080

# Resource Boundaries
HOST_CPUS=2.0
HOST_MEMORY=4GiB
HOST_PIDS=512
HOST_SHM_SIZE=512m

# Non-root User & Group (matches pwuser in Playwright base image)
HOST_UID=1000
HOST_GID=1000

# Allowed Internal Endpoints & Ports (comma-separated list for host netguard firewall)
ALLOWED_INTERNAL_IPS=172.31.240.20,172.31.240.21
ALLOWED_INTERNAL_PORTS=8000,8443

# Proxy Bypass List (exact hostnames/IPs only, NO CIDRs/wildcards)
NO_PROXY=localhost,127.0.0.1,172.31.240.20,172.31.240.21
