# ==============================================================================
# Claude SDK Host Environment Configuration (.env.example)
#
# IMPORTANT: Never commit actual API keys, secrets, or tokens to this repository.
# Operator secret directory must be stored outside Git (e.g. /etc/claude-sdk-host/secrets/).
# ==============================================================================

# Image/dependency versions are pinned in Dockerfiles and pyproject.toml.

# Host Secret Directory Path (Operator-provisioned outside repository, mounted read-only)
HOST_SECRETS_DIR=/etc/claude-sdk-host/secrets

# Static Hosts File (Generated via deploy/scripts/generate-peers.sh)
HOSTS_FILE=./deploy/hosts

# Internal Network Subnets (/28 CIDRs - verify with deploy/scripts/preflight-check.sh)
SDK_CLIENTS_SUBNET=10.253.240.0/28
SDK_CLIENTS_GATEWAY=10.253.240.1

SDK_TOOLS_SUBNET=10.253.240.16/28
SDK_TOOLS_GATEWAY=10.253.240.17

SDK_PROXY_SUBNET=10.253.240.32/28
SDK_PROXY_GATEWAY=10.253.240.33

SDK_UPSTREAM_SUBNET=10.253.240.48/28
SDK_UPSTREAM_GATEWAY=10.253.240.49

# Fixed Static IP Addresses
NETGUARD_CLIENTS_IP=10.253.240.2
NETGUARD_TOOLS_IP=10.253.240.18
NETGUARD_PROXY_IP=10.253.240.34

EGRESS_PROXY_IP=10.253.240.35
EGRESS_UPSTREAM_CLIENT_IP=10.253.240.50
EGRESS_UPSTREAM_IP=192.0.2.10 # replace with your actual numeric parent proxy IP
EGRESS_UPSTREAM_PORT=1080

# Resource Boundaries
HOST_CPUS=2.0
HOST_MEMORY=4GiB
HOST_PIDS=512
HOST_SHM_SIZE=512m

# Non-root User & Group (matches the application image UID/GID)
HOST_UID=1000
HOST_GID=1000

# Allowed Internal Endpoints & Ports (comma-separated list for host netguard firewall)
ALLOWED_INTERNAL_IPS=10.253.240.20,10.253.240.21
ALLOWED_INTERNAL_PORTS=8000,8443

# Proxy Bypass List (exact hostnames/IPs only, NO CIDRs/wildcards)
NO_PROXY=localhost,127.0.0.1,10.253.240.20,10.253.240.21
