# Source from claude-sdk-host directory; operator values stay outside Git.
COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml
HOST_SECRETS_DIR=/ABSOLUTE/OUTSIDE/GIT/sdk-local-secrets
EGRESS_UPSTREAM_IP=192.0.2.10
EGRESS_UPSTREAM_PORT=1080
LOCAL_SDK_PORT=18080
AUTH_VOLUME=claude_sdk_local_auth
JOURNAL_VOLUME=claude_sdk_local_journal
# host-config.json may use one completion-only app for the first live test.
# gost-config.json must point to your real Docker-reachable parent; 192.0.2.10 is a placeholder.
# Keep local auth volume after owner login. Never run down --volumes with real auth.
