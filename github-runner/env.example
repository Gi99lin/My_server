# Copy to .env and fill in RUNNER_TOKEN (never commit the real .env - it's
# gitignored). Full deployment steps: SETUP.md.

# ── Required, secret ─────────────────────────────────────────────────────
# A registration token from
#   gh api -X POST repos/Gi99lin/ai-testcase-generator/actions/runners/registration-token
# valid for about one hour. Never paste it here by hand - pipe it in over
# ssh right before `docker compose up -d` (SETUP.md, step 2). Only needed
# again if the runner is fully re-registered (SETUP.md, "Rotating the
# registration"); an ordinary restart reuses the persisted registration and
# does not read this value.
RUNNER_TOKEN=

# ── Already correct for this deployment ──────────────────────────────────
REPO_URL=https://github.com/Gi99lin/ai-testcase-generator
RUNNER_NAME=tms-ci-runner-1
# config.sh adds self-hosted, linux and x64 automatically; this is the one
# project label added on top of those.
LABELS=tms
